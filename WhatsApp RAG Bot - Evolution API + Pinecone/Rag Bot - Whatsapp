    {
      "parameters": {
        "jsCode": "const storeKey = $input.first().json.storeKey;\nconst myLastTimestamp = $input.first().json.lastTimestamp;\nconst remoteJid = $input.first().json.remoteJid;\nconst pushName = $input.first().json.pushName;\nconst debounceMs = $input.first().json.debounceMs;\n\nconst stored = $getWorkflowStaticData('global');\nlet buffer = null;\ntry { buffer = stored[storeKey] ? JSON.parse(stored[storeKey]) : null; } catch(e) {}\n\nif (!buffer) return [];\n\nconst bufferLastTimestamp = buffer.lastTimestamp || 0;\nconst now = Date.now();\nconst timeSinceLast = now - bufferLastTimestamp;\n\n// Chegou mensagem mais nova durante o wait → aborta\nif (bufferLastTimestamp > myLastTimestamp) return [];\n\n// Debounce ainda não completou → aborta\nif (timeSinceLast < debounceMs - 200) return [];\n\nconst messages = buffer.messages || [];\nconst consolidatedText = messages.join(' ');\n\n// Limpa buffer\ndelete stored[storeKey];\n\nreturn [{ json: { remoteJid, pushName, consolidatedText, messageCount: messages.length, messages } }];"
      },
