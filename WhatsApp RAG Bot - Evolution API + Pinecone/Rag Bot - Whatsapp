    {
      "parameters": {
        "jsCode": "// Extrai e normaliza os campos do payload da Evolution API\nconst body = $input.first().json.body || $input.first().json;\n\n// Suporte a Evolution v1 e v2\nconst data = body.data || body;\nconst key = data.key || {};\nconst message = data.message || {};\n\nconst remoteJid = key.remoteJid || '';\nconst fromMe = key.fromMe || false;\nconst pushName = data.pushName || 'Usuário';\n\n// Ignora mensagens enviadas pelo próprio bot\nif (fromMe) {\n  return [];\n}\n\n// Ignora grupos (remoteJid com @g.us)\nif (remoteJid.includes('@g.us')) {\n  return [];\n}\n\n// Extrai o texto da mensagem (suporte a texto simples, extended e listResponseMessage)\nconst textContent = \n  message.conversation ||\n  message.extendedTextMessage?.text ||\n  message.listResponseMessage?.singleSelectReply?.selectedRowId ||\n  message.buttonsResponseMessage?.selectedButtonId ||\n  '';\n\nif (!textContent || textContent.trim() === '') {\n  return [];\n}\n\nreturn [{\n  json: {\n    remoteJid,\n    pushName,\n    text: textContent.trim(),\n    timestamp: Date.now()\n  }\n}];"
      },
      "id": "4098dc28-2962-4fd9-ab8b-5f612e2e6d94",
      "name": "🔍 Parsear Payload Evolution",
      "type": "n8n-nodes-base.code",
      "position": [
        2064,
        1136
      ],
      "typeVersion": 2
    },
    {
      "parameters": {
        "jsCode": "const remoteJid = $input.first().json.remoteJid;\nconst newText = $input.first().json.text;\nconst pushName = $input.first().json.pushName;\nconst now = Date.now();\nconst debounceMs = 2000; // fixo aqui, sem depender de outros nós\n\nconst storeKey = `buffer_${remoteJid.replace(/[^a-zA-Z0-9]/g, '_')}`;\n\nconst stored = $getWorkflowStaticData('global');\nlet buffer = null;\ntry { buffer = stored[storeKey] ? JSON.parse(stored[storeKey]) : null; } catch(e) {}\n\nlet messages = [];\nlet firstTimestamp = now;\nif (buffer) {\n  messages = buffer.messages || [];\n  firstTimestamp = buffer.firstTimestamp || now;\n}\n\nmessages.push(newText);\n\nstored[storeKey] = JSON.stringify({\n  messages,\n  firstTimestamp,\n  lastTimestamp: now,\n  remoteJid,\n  pushName,\n  debounceMs\n});\n\nreturn [{ json: { remoteJid, pushName, messages, firstTimestamp, lastTimestamp: now, storeKey, debounceMs } }];"
      },
